# ==============================================================
# SHAKTIX WhatsApp Bulk Sender & Custom CRM Environment Setup
# ==============================================================

PORT=5000
NODE_ENV=development

# 1. Meta WhatsApp Cloud API Credentials
# Get these from: developers.facebook.com -> Your App -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token_here
WHATSAPP_API_VERSION=v21.0

# 2. Webhook Configuration
# Used by Meta to verify your webhook URL (e.g. https://yourdomain.com/api/webhook)
WEBHOOK_VERIFY_TOKEN=shaktix_secure_verify_token_2026

# 3. Rate Limiting / Safe Pace (Messages per second)
MAX_MESSAGES_PER_SECOND=15

# 4. Optional Database (PostgreSQL / Supabase connection URI)
DATABASE_URL=postgresql://postgres:password@localhost:5432/shaktix_bulk_crm
